rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'sunilnirwan55@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      
      // User can create their initial profile upon registration
      // Cannot set role to 'admin' or give themselves money
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.totalAmount == 0 &&
        request.resource.data.get('shares', 1) == 1
      );

      // User can only update profile fields (name, mobile, address, occupation)
      // Cannot elevate role or modify financial totalAmount (deposits are credited by admin approval)
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.get('shares', 1) == resource.data.get('shares', 1) &&
        request.resource.data.userId == resource.data.userId
      );

      allow delete: if isAdmin();
    }

    // Loans collection
    match /loans/{loanId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      
      // User can apply for loan only with their own UID, as 'pending' (admin approves), 10 months term, 10% flat interest
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.totalMonths == 10 &&
        request.resource.data.paidMonths == 0 &&
        request.resource.data.paidAmount == 0 &&
        request.resource.data.totalPayable == math.round(request.resource.data.loanAmount * 1.1) &&
        request.resource.data.pendingAmount == request.resource.data.totalPayable
      );

      // Installments are marked paid only when admin approves a payment request
      allow update: if isAdmin();

      allow delete: if isAdmin();

      // Installments subcollection
      match /installments/{installmentId} {
        allow read: if isAdmin() || (
          isSignedIn() && 
          get(/databases/$(database)/documents/loans/$(loanId)).data.userUid == request.auth.uid
        );
        allow create, update: if isAdmin() || (
          isSignedIn() && 
          get(/databases/$(database)/documents/loans/$(loanId)).data.userUid == request.auth.uid
        );
        allow delete: if isAdmin();
      }
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      // Members can only submit a request; admin approves / rejects it
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == 'Pending'
      );
      allow update, delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{txnId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Counters collection for unique atomic SOCITYxxxx and LOANxxxx generation
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }
  }
}
